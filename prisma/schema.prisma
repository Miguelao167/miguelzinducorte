generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("owner")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  pixConfig PixConfig?
}

model Agendamento {
  id            String   @id @default(cuid())
  nomeCliente   String
  telefone      String
  servico       String?
  preco         String?
  dataPreferida String?
  horario       String?
  observacoes   String?
  status        String   @default("pendente")
  pago          Boolean  @default(false)
  valorPago     Float?
  metodoPagamento String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Saque {
  id          String   @id @default(cuid())
  valor       Float
  chavePix    String
  status      String   @default("pendente")
  observacao  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Pagamento {
  id              String   @id @default(cuid())
  agendamentoId   String?
  paymentId       String?  @unique
  valor           Float
  status          String   @default("pendente")
  qrCode          String?
  qrCodeText      String?
  externalRef     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PixConfig {
  id              String   @id @default(cuid())
  userId          String   @unique
  chavePix        String
  tipoChave       String   // cpf, cnpj, email, telefone, aleatoria
  nomeRecebedor   String
  cidade          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id])
}